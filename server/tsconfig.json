{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"target": "ES2022",
		"module": "CommonJS",
		"moduleResolution": "Node",
		"rootDir": ".",
		"outDir": "dist",
		"lib": ["ES2022"],
		"types": ["node"],
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": false
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
